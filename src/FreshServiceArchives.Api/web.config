<?xml version="1.0" encoding="utf-8"?>
<!--
  Base web.config. `dotnet publish` injects the ASP.NET Core Module handler and the
  <aspNetCore> element into this file. We bake Windows Authentication in here (rather
  than only setting it in IIS Manager) so it survives every redeploy that overwrites
  web.config — the same approach the TremblantOnboarding site uses on this server.
-->
<configuration>
  <system.webServer>
    <security>
      <authentication>
        <windowsAuthentication enabled="true" />
        <anonymousAuthentication enabled="false" />
      </authentication>
    </security>
  </system.webServer>
</configuration>
